{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "registry/node_modules",
    "generated",
    "patterns",
    "registry/components"
  ]
}
