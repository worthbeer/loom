{
  "name": "loom",
  "version": "1.0.0",
  "description": "Agentic, Storybook-style component library: generates convention-compliant components from design intent, checked by an independent critic and a deterministic gate before anything lands as a PR.",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=23.6.0"
  },
  "bin": {
    "loom": "./loom.ts"
  },
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "generate": "node loom.ts generate",
    "validate": "node validate.ts",
    "bridge": "node bridge-server.ts",
    "tokens:build": "node tools/generate_tokens_css.ts && node tools/generate_token_resolver.ts"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  }
}
